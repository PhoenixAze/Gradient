# ============================================================================
# Gradient — Mühit dəyişənləri (şablon)
# BU FAYL HESAB DEYİL. Real dəyərlər yalnız Render.com dashboard-da
# (Environment Variables) və lokal .env faylında saxlanılır.
# Heç bir açar/version kontroluna commit EDİLMİR.
# ============================================================================

# FastAPI backend-inin ünvanı (Render.com)
BACKEND_API_URL=

# Google Gemini API açarı — yalnız server tərəfdə istifadə olunur,
# frontend-ə heç vaxt ötürülmür.
GEMINI_API_KEY=

# CORS icazə verilən mənşələr (vergüllə ayrılmış siyahı).
# Wildcard (*) qəti qadağandır.
ALLOWED_ORIGINS=http://localhost:3000,https://gradient.az,https://www.gradient.az,https://phoenixaze.github.io

# Diaqnostik jurnal: 'off' olsa JSON loglar söndürülür
DIAG_LOG=on

# Production-da 'production' olmalıdır — bu, dev-fallback mağazasını söndürür
# (autentifikasiya edilməmiş istifadəçi real cavab ala bilməz).
NODE_ENV=production
