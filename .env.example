# ============================================================================
# Gradient — Mühit dəyişənləri (şablon)
# BU FAYL HESAB DEYİL. Real dəyərlər yalnız Render.com dashboard-da
# (Environment Variables) və lokal .env faylında saxlanılır.
# Heç bir açar/version kontroluna commit EDİLMİR.
# ============================================================================

# FastAPI backend-inin ünvanı (Render.com)
BACKEND_API_URL=

# Google Gemini API açarı — yalnız server tərəfdə istifadə olunur,
# frontend-ə heç vaxt ötürülmür.
GEMINI_API_KEY=

# CORS icazə verilən mənşələr (vergüllə ayrılmış siyahı).
# Wildcard (*) qəti qadağandır.
ALLOWED_ORIGINS=http://localhost:3000,https://gradient.az,https://www.gradient.az,https://phoenixaze.github.io

# Diaqnostik jurnal: 'off' olsa JSON loglar söndürülür
DIAG_LOG=on

# Production-da 'production' olmalıdır — bu, dev-fallback mağazasını söndürür
# (autentifikasiya edilməmiş istifadəçi real cavab ala bilməz).
NODE_ENV=production

# ---------------------------------------------------------------------------
# ADMIN DEBUG KONSOLU (FastAPI /api/v1/debug/*)
# ---------------------------------------------------------------------------
# X-Debug-Key başlığı ilə göndərilən giriş açarı. Sahə boş və ya təyin
# edilməmişsə panel QAPIDIR (fail-closed) — endpoint-lər 403 qaytarır.
#
# TƏLƏBLƏR:
#   • Ən azı 32 simvol, yalnız [A-Za-z0-9] — əks halda endpoint-lər 403 verir.
#   • Dəyişiklik etdikdə KÖHNƏ açar render logunda da silinməlidir,
#     əks halda server köhnə konfiqurasiyanı oxumaqda davam edir.
#   • Bu dəyər heç vaxt frontend-ə (GitHub Pages) yazılmır.
#
# Yeni açar yaratmaq (PowerShell):
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# YENİ QAZANÇLAR (bütün dəyişikliklər Render dashboard-da tətbiq edilməlidir):
#   DEBUG_SECRET_KEY
#   RATE_LIMIT_READ_MAX=60
#   RATE_LIMIT_WRITE_MAX=20
#   RATE_LIMIT_AI_MAX=5
# ---------------------------------------------------------------------------
DEBUG_SECRET_KEY=
RATE_LIMIT_READ_MAX=60
RATE_LIMIT_WRITE_MAX=20
RATE_LIMIT_AI_MAX=5
